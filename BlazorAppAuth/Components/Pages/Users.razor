@page "/users"
@using BlazorAppAuth.ViewModel
@using BlazorAppAuth.Services
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IAccountManagement Acct
@inject NavigationManager Navigation

@attribute [Authorize(Roles = "admin")]

<h3 class="mb-4 text-primary">Users Management</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<div class="mb-3">
    <InputText class="form-control" @bind-Value="searchText" placeholder="Search by Name" @oninput="OnSearchChanged" />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>User Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in FilteredUserList())
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        @if (user.Roles != null && user.Roles.Count > 0)
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var role in user.Roles)
                                {
                                    <li><span class="badge bg-secondary">@role</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No roles assigned</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => Edit(user.Email)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(user.Email)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (userModel != null)
{
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <strong>Edit User</strong>
        </div>
        <div class="card-body">
            <EditForm Model="@userModel" OnValidSubmit="@UpdateUser">
                <DataAnnotationsValidator></DataAnnotationsValidator>
                <ValidationSummary></ValidationSummary>

                <div class="mb-3">
                    <label class="form-label">Name:</label>
                    <InputText class="form-control" @bind-Value="userModel.UserName" disabled></InputText>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email:</label>
                    <InputText class="form-control" @bind-Value="userModel.Email"></InputText>
                </div>

                <div class="mb-3">
                    <label class="form-label">Phone Number:</label>
                    <InputText class="form-control" @bind-Value="userModel.PhoneNumber"></InputText>
                </div>

                <div class="mb-3">
                    <label class="form-label">Assign Roles:</label>
                    <div class="form-check">
                        @foreach (var role in availableRoles)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@role.Name"
                                       value="@role.Name"
                                       checked="@SelectedRoles.Contains(role.Name)"
                                       @onchange="(e) => ToggleRoleSelection(role.Name, (bool)e.Value)" />
                                <label class="form-check-label" for="@role.Name">@role.Name</label>
                            </div>
                        }
                    </div>
                </div>


                <button type="submit" class="btn btn-success w-100">Update User</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<UserViewModel> userList = new();
    private UserViewModel userModel = null;
    private List<Role> availableRoles = new();
    private List<string> SelectedRoles = new();
    private string message = "";
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadRoles();
    }

    private async Task LoadUsers()
    {
        try
        {
            var users = await Acct.GetUsers();
            userList = users?.ToList() ?? new List<UserViewModel>();
        }
        catch
        {
            message = "Failed to load users. Please try again.";
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            availableRoles = await Acct.GetRolesAsync();
        }
        catch
        {
            message = "Failed to load roles.";
        }
    }

    async Task Edit(string email)
    {
        try
        {
            userModel = await Acct.GetUserByEmail(email);
            if (userModel != null)
            {
                SelectedRoles = userModel.Roles?.ToList() ?? new List<string>();
            }
        }
        catch
        {
            message = "Error retrieving user details.";
        }
    }

    async Task Delete(string email)
    {
        if (await Acct.UserDelete(email))
        {
            message = "User deleted successfully!";
            await LoadUsers();
        }
        else
        {
            message = "Failed to delete user.";
        }
    }

    private async Task UpdateUser()
    {
        if (userModel != null)
        {
            userModel.Roles = SelectedRoles;
            var success = await Acct.UserUpdate(userModel.Email, userModel);
            if (success)
            {
                message = "User updated successfully!";
                userModel = null;
                await LoadUsers();
            }
            else
            {
                message = "Error updating user.";
            }
        }
    }
    private void ToggleRoleSelection(string roleName, bool isSelected)
    {
        if (isSelected)
        {
            if (!SelectedRoles.Contains(roleName))
            {
                SelectedRoles.Add(roleName);
            }
        }
        else
        {
            SelectedRoles.Remove(roleName);
        }
    }

    // Search logic
    private IEnumerable<UserViewModel> FilteredUserList()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return userList;
        }

        return userList.Where(u => u.UserName.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }


    // Called when search text changes
    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value.ToString();
    }

}
