@page "/AddRoles"
@using BlazorAppAuth.Services
@using BlazorAppAuth.ViewModel
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]
@inject IAccountManagement Acct

<h3 class="mb-4 text-primary">Manage Roles</h3>

@if (roleList?.Count > 0)
{
    <div class="mb-3">
        <h5>Existing Roles:</h5>
        <ul class="list-group">
            @foreach (var role in roleList)
            {
                <li class="list-group-item">@role.Name</li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

@if (Roles.Count == 0)
{
    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Enter new role" @bind="NewRole" />
        <button class="btn btn-primary" @onclick="AddRole">Add Role</button>
    </div>
}
else
{
    <h5>New Roles:</h5>
    <ul class="list-group mb-3">
        @foreach (var role in Roles)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@role</span>
                <button class="btn btn-danger btn-sm" @onclick="() => RemoveRole(role)">Remove</button>
            </li>
        }
    </ul>

    <div class="input-group mb-3">
        <input type="text" class="form-control" placeholder="Enter new role" @bind="NewRole" />
        <button class="btn btn-primary" @onclick="AddRole">Add Role</button>
    </div>

    <button class="btn btn-success w-100" @onclick="SubmitRole">Submit Roles</button>
}

@if (!string.IsNullOrEmpty(submitMessage))
{
    <div class="alert alert-success mt-3">@submitMessage</div>
}

@code {
    string submitMessage = string.Empty;
    string message = string.Empty;
    List<string> Roles = new List<string>();
    List<Role> roleList = new List<Role>();
    string NewRole { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await GetRoles();
    }

    private async Task GetRoles()
    {
        try
        {
            var list = await Acct.GetRolesAsync();
            roleList = list.ToList();
        }
        catch (Exception ex)
        {
            message = "Failed to load roles. Please try again.";
        }
        StateHasChanged();
    }

    private void AddRole()
    {
        if (!string.IsNullOrWhiteSpace(NewRole))
        {
            if (!Roles.Contains(NewRole, StringComparer.OrdinalIgnoreCase))
            {
                Roles.Add(NewRole);
                message = "Role added successfully.";
            }
            else
            {
                message = "This role already exists.";
            }
            NewRole = string.Empty;
        }
        else
        {
            message = "Role name cannot be empty.";
        }
    }

    private void RemoveRole(string role)
    {
        Roles.Remove(role);
        message = "Role removed.";
    }

    private async Task SubmitRole()
    {
        submitMessage = string.Empty;
        try
        {
            var response = await Acct.AddRoleAsync(Roles.ToArray());
            if (response.Succeeded)
            {
                submitMessage = "Roles added successfully!";
                Roles.Clear();
                await GetRoles();
            }
            else
            {
                submitMessage = "Failed to add roles.";
            }
        }
        catch (Exception ex)
        {
            submitMessage = "An error occurred while submitting roles.";
        }
    }
}
